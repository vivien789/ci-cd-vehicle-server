{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*", "db/**/*", "client/controller/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
